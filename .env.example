# Server settings. install.sh copies this to .env; .env is never pushed to GitHub.
SYNC_HOST=0.0.0.0
SYNC_PORT=8080
# Largest single sync upload in MB. Raise it if a big deck with lots of media fails to upload.
MAX_SYNC_PAYLOAD_MEGS=200
# The address customers type into Anki; only used in the message add-user.sh prints.
PUBLIC_URL=http://YOUR-SERVER-IP:8080/

# Accounts, one per line, numbered 1, 2, 3 ... with no gaps.
# Manage them with scripts/add-user.sh and scripts/disable-user.sh.
